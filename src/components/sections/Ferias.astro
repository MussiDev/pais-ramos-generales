---
import { ferias } from '../../content/copy';
import { nextFair } from '../../content/fairs';
import Placeholder from '../Placeholder.astro';

// Festival bunting: flags hang along a quadratic string from (0,8) to (1440,8), sagging to 48.
const WIDTH = 1440;
const FLAGS = 13;
const stringY = (x: number) => {
  const t = x / WIDTH;
  return (1 - t) ** 2 * 8 + 2 * (1 - t) * t * 48 + t ** 2 * 8;
};
const round = (value: number) => Math.round(value * 10) / 10;
const flags = Array.from({ length: FLAGS }, (_, index) => {
  const x = 40 + index * ((WIDTH - 110) / (FLAGS - 1));
  const y1 = stringY(x);
  const y2 = stringY(x + 30);
  return {
    d: `M${round(x)} ${round(y1)} L${round(x + 30)} ${round(y2)} L${round(x + 14)} ${round(y1 + 40)} Z`,
    tone: index % 4,
  };
});
---

<section id="ferias" class="ferias" aria-labelledby="ferias-title">
  <svg
    class="bunting"
    viewBox="0 0 1440 70"
    preserveAspectRatio="xMidYMin slice"
    aria-hidden="true"
    focusable="false"
  >
    <path class="bunting__string" d="M0 8 Q720 48 1440 8"></path>
    {flags.map((flag) => <path class={`bunting__flag bunting__flag--${flag.tone}`} d={flag.d} />)}
  </svg>

  <div class="ferias__inner">
    <div class="ferias__heading">
      <p class="eyebrow ferias__eyebrow"><Placeholder text={ferias.eyebrow} /></p>
      <h2 id="ferias-title" class="ferias__title">
        <Placeholder text={ferias.titleLead} />
        <em><Placeholder text={ferias.titleEmphasis} /></em>
      </h2>
    </div>

    <article class="fair-card" aria-labelledby="fair-card-title">
      <p class="fair-card__date">
        <span>{ferias.nextDateLabel}</span>
        <span><Placeholder text={nextFair.date} /></span>
      </p>
      <h3 id="fair-card-title" class="fair-card__name"><Placeholder text={nextFair.name} /></h3>
      <ul class="fair-card__details">
        <li>
          <svg
            class="icon"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path>
            <circle cx="12" cy="9.5" r="2.5"></circle>
          </svg>
          <span><Placeholder text={nextFair.place} /></span>
        </li>
        <li>
          <svg
            class="icon"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
          <span><Placeholder text={nextFair.hours} /></span>
        </li>
      </ul>
    </article>
  </div>
</section>
