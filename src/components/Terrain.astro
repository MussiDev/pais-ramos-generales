---
/**
 * One part of a province landscape (scene data in `landscapes.ts`): the wide `ground` strip for
 * the bottom of the panel, or the `landmark` figure. Both keep their proportions ("slice"), so a
 * figure is never stretched; the ground is anchored bottom-right, like the landmark.
 */
import type { Terrain } from '../content/types';
import { H, scenes, W } from './landscapes';

interface Props {
  type: Terrain;
  part: 'ground' | 'landmark';
  class?: string;
}

const { type, part, class: className } = Astro.props;
const scene = scenes[type];
const { viewBox, layers } =
  part === 'ground' ? { viewBox: `0 0 ${W} ${H}`, layers: scene.ground } : scene.landmark;
---

<svg
  class:list={[part === 'ground' ? 'terrain' : 'terrain-landmark', `${part === 'ground' ? 'terrain' : 'terrain-landmark'}--${type}`, className]}
  viewBox={viewBox}
  preserveAspectRatio="xMaxYMax slice"
  aria-hidden="true"
  focusable="false"
  data-terrain={part === 'ground' ? type : undefined}
>
  {layers.map(({ layer, d }) => <path class={`terrain__${layer}`} d={d} />)}
</svg>
