---
/**
 * Simplified Argentina outline with the store origin (Funes), one pin per stop and the route
 * path through them in order. Pin coordinates come from the content layer (`MAP_VIEWBOX` space).
 */
import { FUNES_PIN, MAP_VIEWBOX } from '../content/provinces';
import type { MapPin, Province } from '../content/types';

interface Props {
  provinces: Province[];
  originLabel: string;
  /** Accessible title of the map (from the content layer). */
  title: string;
  /** `id` of the route path; motion (Block 5) scrubs its stroke-dashoffset. */
  routeId: string;
  class?: string;
}

const { provinces, originLabel, title, routeId, class: className } = Astro.props;

const viewBox = `${MAP_VIEWBOX.x} ${MAP_VIEWBOX.y} ${MAP_VIEWBOX.width} ${MAP_VIEWBOX.height}`;

// Each leg is a quadratic curve bent sideways by a fraction of its length.
const BEND = 0.18;
const round = (value: number) => Math.round(value * 10) / 10;
const points: MapPin[] = [FUNES_PIN, ...provinces.map((province) => province.pin)];
const legs = points.slice(1).map((to, index) => {
  const from = points[index];
  const dx = to.x - from.x;
  const dy = to.y - from.y;
  const cx = (from.x + to.x) / 2 + dy * BEND;
  const cy = (from.y + to.y) / 2 - dx * BEND;
  return `Q${round(cx)} ${round(cy)} ${to.x} ${to.y}`;
});
const routePath = `M${FUNES_PIN.x} ${FUNES_PIN.y} ${legs.join(' ')}`;

// Label placement keeps text inside the viewBox: left of west pins, above east pins.
const label = (pin: MapPin) => {
  if (pin.x < 150) return { x: pin.x - 14, y: pin.y + 4, anchor: 'end' };
  if (pin.x >= 230) return { x: pin.x, y: pin.y - 16, anchor: 'middle' };
  return { x: pin.x + 12, y: pin.y + 16, anchor: 'start' };
};

const titleId = `${routeId}-title`;
---

<svg
  class:list={['map', className]}
  viewBox={viewBox}
  role="img"
  aria-labelledby={titleId}
  data-map
>
  <title id={titleId}>{title}</title>
  <path
    class="map__outline"
    d="M111 2 L156 4 L231 66 L256 108 L291 84 L280 110 L255 130 L231 164 L219 240 L219 252 L235 276 L245 286 L232 320 L160 336 L150 370 L120 380 L141 412 L118 430 L82 476 L110 504 L90 540 L60 592 L69 606 L16 600 L0 560 L15 500 L19 440 L18 360 L37 280 L45 220 L60 120 L70 50 L90 16 Z"
  ></path>
  <path class="map__outline" d="M66 616 L115 654 L66 660 Z"></path>

  <path class="map__route-guide" d={routePath} aria-hidden="true"></path>
  <path id={routeId} class="map__route" d={routePath} data-route></path>

  <g class="map__origin" aria-hidden="true">
    <circle class="map__origin-dot" cx={FUNES_PIN.x} cy={FUNES_PIN.y} r="7"></circle>
    <text class="map__label map__label--origin" x={FUNES_PIN.x - 12} y={FUNES_PIN.y - 12} text-anchor="end"
      >{originLabel}</text
    >
  </g>

  {
    provinces.map((province, index) => {
      const position = label(province.pin);
      return (
        <g class="map__pin" data-pin={province.id} data-stop-index={index} aria-hidden="true">
          <circle class="map__pin-halo" cx={province.pin.x} cy={province.pin.y} r="12" />
          <circle class="map__pin-dot" cx={province.pin.x} cy={province.pin.y} r="5" />
          <text class="map__label" x={position.x} y={position.y} text-anchor={position.anchor}>
            {province.name}
          </text>
        </g>
      );
    })
  }
</svg>
