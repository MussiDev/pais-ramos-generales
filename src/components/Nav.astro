---
import { nav } from '../content/copy';
import WhatsAppLink from './WhatsAppLink.astro';
import logoMarkRaw from '../assets/logo/leaf-ornament.svg?raw';

const logoMark = logoMarkRaw.replace('<svg', '<svg class="wordmark__mark" aria-hidden="true"');
---

<header class="site-header">
  <a class="wordmark" href="#main" aria-label={nav.homeLabel}>
    <Fragment set:html={logoMark} />
  </a>

  <nav class="site-nav" aria-label={nav.navLabel}>
    <ul class="site-nav__list">
      {
        nav.links.map((link) => (
          <li>
            <a class="site-nav__link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <WhatsAppLink class="btn btn--outline site-header__cta">
    <svg
      class="icon"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M3.5 20.5l1.3-4A8.5 8.5 0 1 1 8 19.3z"></path>
      <path d="M9 9.5c.3 2.3 2.2 4.4 4.6 5l1.2-1.2 2 .9-.4 1.6c-3.9.4-8-3.6-7.6-7.6l1.6-.4.9 2z"
      ></path>
    </svg>
    <span class="site-header__cta-text">{nav.cta}</span>
  </WhatsAppLink>
</header>
