---
/** Persistent floating WhatsApp CTA, pinned to the viewport across every section. */
import WhatsAppLink from './WhatsAppLink.astro';
---

<WhatsAppLink class="whatsapp-float" aria-label="Escribinos por WhatsApp">
  <svg
    class="whatsapp-float__icon"
    viewBox="0 0 24 24"
    width="28"
    height="28"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M3.5 20.5l1.3-4A8.5 8.5 0 1 1 8 19.3z"></path>
    <path
      d="M9 9.5c.3 2.3 2.2 4.4 4.6 5l1.2-1.2 2 .9-.4 1.6c-3.9.4-8-3.6-7.6-7.6l1.6-.4.9 2z"
    ></path>
  </svg>
</WhatsAppLink>
